# Copy to .env for local development. Never commit real secrets.
#
# This file is the single source of truth for which environment variables the
# platform reads (docs/CODING_STANDARDS.md §13) -- every variable a settings module
# in config/modules/ can consume is listed here, grouped by module, with its default
# noted. Precedence (highest wins): real OS env vars > this file (as `.env`) >
# config/environments/{ENVIRONMENT}.yaml > the module's own field default. See
# config/loader.py.
#
# Original Phase 2 variables are preserved as-is below for backward compatibility;
# each is also readable by its typed module via an alias (see config/modules/*.py).

# --- Root ---------------------------------------------------------------------
ENVIRONMENT=dev
DEBUG=false

# --- Application (config/modules/application.py, prefix APP_) -----------------
APP_NAME=ai-trading-platform
APP_VERSION=0.1.0
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

# --- Database engine/pool (config/modules/database.py, prefix DATABASE_) ------
# Full DSN override. Takes precedence over the discrete POSTGRES_* vars below.
DATABASE_URL=postgresql://trading:trading@localhost:5432/trading_platform
DATABASE_DRIVER=postgresql+asyncpg
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- PostgreSQL connection identity (config/modules/postgresql.py, prefix POSTGRES_) --
# Only used to build a DSN when DATABASE_URL above is unset.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
# POSTGRES_DATABASE also accepts the name POSTGRES_DB (matching docker-compose.yml's
# postgres container and the official postgres Docker image's own env var).
POSTGRES_DATABASE=trading_platform
POSTGRES_SSLMODE=prefer

# --- Redis (config/modules/redis.py, prefix REDIS_) ----------------------------
# Full URL override. Takes precedence over the discrete REDIS_* vars below.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_USE_TLS=false

# --- Kafka (config/modules/kafka.py, prefix KAFKA_) ----------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=ai-trading-platform
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMER_GROUP_ID=ai-trading-platform

# --- Binance (config/modules/binance.py, prefix BINANCE_) ----------------------
# BINANCE_API_KEY/BINANCE_API_SECRET also accept the legacy
# MARKET_DATA_VENDOR_API_KEY/MARKET_DATA_VENDOR_API_SECRET names below.
BINANCE_API_KEY=changeme
BINANCE_API_SECRET=changeme
MARKET_DATA_VENDOR_API_KEY=changeme
MARKET_DATA_VENDOR_API_SECRET=changeme
BINANCE_USE_TESTNET=true

# --- AI Models (config/modules/ai_models.py, prefix AI_MODEL_) -----------------
AI_MODEL_REGISTRY_URI=file:///var/lib/ai-trading-platform/model_registry
AI_MODEL_DEFAULT_MODEL_NAME=baseline-momentum
AI_MODEL_DEFAULT_MODEL_STAGE=champion
AI_MODEL_DEVICE=cpu
AI_MODEL_CANARY_TRAFFIC_PERCENTAGE=0

# --- Feature Engineering (config/modules/feature_engineering.py, prefix FEATURE_) --
FEATURE_ONLINE_STORE_BACKEND=redis
FEATURE_ONLINE_STORE_TTL_SECONDS=3600
FEATURE_OFFLINE_STORE_PATH=/var/lib/ai-trading-platform/feature_store/offline
FEATURE_PARALLEL_WORKERS=4

# --- Logging (config/modules/logging.py, prefix LOG_) --------------------------
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true
LOG_INCLUDE_CORRELATION_ID=true

# --- Monitoring (config/modules/monitoring.py, prefix MONITORING_) -------------
MONITORING_METRICS_ENABLED=true
MONITORING_METRICS_PORT=9100
MONITORING_TRACING_ENABLED=false
MONITORING_TRACING_EXPORTER_ENDPOINT=

# --- API (config/modules/api.py, prefix API_) -----------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_CORS_ALLOWED_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true

# --- WebSocket (config/modules/websocket.py, prefix WEBSOCKET_) ----------------
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8001
WEBSOCKET_PATH=/ws

# --- Security (config/modules/security.py, prefix SECURITY_) -------------------
# SECURITY_JWT_SECRET also accepts the legacy JWT_SECRET name below.
SECURITY_JWT_SECRET=changeme
JWT_SECRET=changeme
SECURITY_JWT_ALGORITHM=HS256
SECURITY_SECURE_COOKIES=false
SECURITY_MFA_REQUIRED_FOR_TRADING=true
